{{ ansible_managed | comment }}

[Interface]
PrivateKey = {{ wireguard_private_key }}
Address = {{ wireguard_addr4 }}, {{ wireguard_addr6 }}
ListenPort = {{ wireguard_listen_port }}
SaveConfig = false

{% if wireguard_tunnel_everything %}
DNS = 1.1.1.1, 1.0.0.1, 2606:4700:4700::1111, 2606:4700:4700::1001
{% endif %}

{% if wireguard_server %}
PostUp = iptables -t nat -A POSTROUTING -s {{ wireguard_addr4 }} -m policy --pol none --dir out -j MASQUERADE
PostUp = iptables -A FORWARD -s {{ wireguard_addr4 }} -j ACCEPT
PostUp = ip6tables -t nat -A POSTROUTING -s {{ wireguard_addr6 }} -m policy --pol none --dir out -j MASQUERADE
PostUp = ip6tables -A FORWARD -s {{ wireguard_addr6 }} -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -s {{ wireguard_addr4 }} -m policy --pol none --dir out -j MASQUERADE
PostDown = iptables -D FORWARD -s {{ wireguard_addr4 }} -j ACCEPT
PostDown = ip6tables -t nat -A POSTROUTING -s {{ wireguard_addr6 }} -m policy --pol none --dir out -j MASQUERADE
PostDown = ip6tables -D FORWARD -s {{ wireguard_addr6 }} -j ACCEPT
{% endif %}
{% if wireguard_peers is defined %}
{% for peer in wireguard_peers %}

[Peer]
PublicKey = {{ peer.public_key }}
{% if peer.preshared_key is defined %}
PresharedKey = {{ peer.preshared_key }}
{% endif %}
{% if wireguard_tunnel_everything %}
AllowedIPs = 0.0.0.0/0, ::/0
{% elif peer.allowed_ips is defined %}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% endif %}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.persistent_keepalive is defined and peer.persistent_keepalive %}
PersistentKeepalive = 25
{% endif %}
{% endfor %}
{% endif %}
